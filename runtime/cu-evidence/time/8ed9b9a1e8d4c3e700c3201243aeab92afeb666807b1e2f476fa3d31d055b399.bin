				</div>
				<script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
<script type="text/javascript">
    // 초기 데이터 로드
    let dates = ["2026-10-15","2026-10-16","2026-10-19","2026-10-20","2026-10-21","2026-10-22"];
    let navPrices = [0,"-1.77","-6.13","-4.56","-4.92","-2.77"];
    let bmPrices = [0,"-0.63","-3.58","-2.62","-2.96","-1.94"];
    let overPrices = [0,"-1.14","-2.55","-1.94","-1.96","-0.83"];

    // 차트 초기화
    let chartContainer = document.getElementById('areaChart');
    let chart = echarts.init(chartContainer);

    let option = {
        tooltip: { 
            trigger: 'axis', 
            axisPointer: { type: 'cross' },
            formatter: function (params) {
                let tooltipText = params[0].axisValue + '<br/>';
                params.forEach(item => {
                    tooltipText += item.marker + " " + item.seriesName + ": " + item.value + "%<br/>";
                });
                return tooltipText;
            },
			show:false
        },
        legend: {
            top: '0%',
            left: 'center',
            data: ['기준가(NAV)','비교지수','초과성과'],
            show: true
        },
		grid: {
			top: '15%',
			left: '5%',
			right: '5%',
			bottom: '7%',
			containLabel: true   // y축/ x축 레이블이 잘리지 않도록 자동 조정
		},
        xAxis: { type: 'category', data: dates, boundaryGap: false },
        yAxis: { 
            type: 'value',
            axisLabel: { formatter: value => value + "%" },
			//min: -10,
			//max: 10,
            //interval: 1,
			//scale:true //자동스케일방지
        },
        series: [
            {
                name: '기준가(NAV)',
                type: 'line',
                itemStyle: { color: 'rgb(255, 99, 132)' },
                //areaStyle: { color: 'rgba(255, 99, 132, 0.5)' },
                lineStyle: { color: 'rgb(255, 99, 132)' },
                smooth: false,
				showSymbol: false,
                data: navPrices
            },
            {
                name: '비교지수',
                type: 'line',
                itemStyle: { color: 'rgb(54, 162, 235)' },
                //areaStyle: { color: 'rgba(54, 162, 235, 0.5)' },
                lineStyle: { color: 'rgb(54, 162, 235)' },
                smooth: false,
				showSymbol: false,
                data: bmPrices
            },
            {
                name: '초과성과',
                type: 'line',
                itemStyle: { color: '#00b5b5' },
                areaStyle: { color: '#33ffff' },
                lineStyle: { color: '#00b5b5' },
				smooth: false, //직선
				showSymbol: false, //마커 없애기
                data: overPrices
            }
        ]
    };

    chart.setOption(option);

	window.addEventListener('resize', function() {//반응형 차트 리사이즈
		chart.resize();
	});


    // 차트 기간 변경 이벤트
    $(document).on('click', '.chartPeriod', function(){
        let period = $(this).data('period');
        let idx = 2;

		// 1. 새로운 차트 로딩시작
        chart.showLoading();

        fetch(`./chart_json.php?idx=${idx}&period=${period}`)
            .then(response => response.json())
            .then(data => {
				const safeDates = Array.isArray(data.dates) ? data.dates : [];
				const safeNavPrices = Array.isArray(data.navPrices) ? data.navPrices : [];
				const safeBmPrices = Array.isArray(data.bmPrices) ? data.bmPrices : [];
				const safeOverPrices = Array.isArray(data.overPrices) ? data.overPrices : [];

                // 2. 기존 차트를 삭제 (확실한 체크 추가)
                if (chart !== null && chart !== undefined) {
                    chart.dispose();
                    chart = null;  // 확실하게 제거
                }

                // 3. 새 차트 초기화
                chart = echarts.init(chartContainer);

                // 4. 새로운 데이터로 차트 업데이트
                chart.setOption({
                    tooltip: { 
                        trigger: 'axis', 
                        axisPointer: { type: 'cross' },
                        formatter: function (params) {
                            let tooltipText = params[0].axisValue + '<br/>';
                            params.forEach(item => {
                                tooltipText += item.marker + " " + item.seriesName + ": " + item.value + "%<br/>";
                            });
                            return tooltipText;
                        },
						show:false
                    },
                    legend: {
                        top: '0%',
                        left: 'center',
                        data: ['기준가(NAV)','비교지수','초과성과'],
                        show: true
                    },
					grid: {
						top: '15%',
						left: '5%',
						right: '5%',
						bottom: '7%',
						containLabel: true // y축/ x축 레이블이 잘리지 않도록 자동 조정
					},
                    xAxis: { type: 'category', data: safeDates, boundaryGap: false },
                    yAxis: { 
                        type: 'value',
                        axisLabel: { formatter: value => value + "%" },
                    },
                    series: [
                        {
                            name: '기준가(NAV)',
                            type: 'line',
                            itemStyle: { color: 'rgb(255, 99, 132)' },
                            lineStyle: { color: 'rgb(255, 99, 132)' },
                            smooth: false,
							showSymbol: false,
                            data: safeNavPrices
                        },
                        {
                            name: '비교지수',
                            type: 'line',
                            itemStyle: { color: 'rgb(54, 162, 235)' },
                            lineStyle: { color: 'rgb(54, 162, 235)' },
                            smooth: false,
							showSymbol: false,
                            data: safeBmPrices
                        },
                        {
                            name: '초과성과',
                            type: 'line',
                            itemStyle: { color: '#00b5b5' },
                            areaStyle: { color: '#33ffff' },
                            lineStyle: { color: '#00b5b5' },
                            smooth: false, //직선
							showSymbol: false, //마커 없애기
                            data: safeOverPrices
                        }
                    ]
                });

                // 5. 로딩 상태 해제
                chart.hideLoading();
            })
            .catch(error => {
                console.error('Error loading data:', error);
				if (chart) {
					chart.hideLoading();
				}
            });
    });
</script>
