<script>
	$(function() {


		/* 구성종목 체크 */
		function getUrlParameter(name) {
			name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
			var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
			var results = regex.exec(location.search);
			return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
		}

		// URL에서 해시 추출하는 함수
		function getUrlHash() {
			return window.location.hash.substring(1); // '#' 제거
		}

		// pdfDate 파라미터 확인
		var pdfDate = getUrlParameter('pdfDate');
		var targetHash = getUrlHash();

		// pdfDate 파라미터가 있고 해시값이 있는 경우
		if (pdfDate && targetHash) {
			// 페이지 로딩 후 약간의 지연시간을 둠 (DOM이 완전히 로드되도록)
			setTimeout(function() {
				var headerH = $("#header").outerHeight();
				var targetElement = $("#" + targetHash);

				if (targetElement.length) {
					// 헤더 높이를 고려한 스크롤 위치 계산 (필요시 오프셋 조정)
					var scrollPosition = targetElement.offset().top - headerH - 20;

					// 부드럽게 스크롤
					$('html, body').animate({
						scrollTop: scrollPosition
					}, 0, function() {
						// 스크롤 완료 후 필요한 처리가 있다면 여기에 추가
						console.log("Scrolled to " + targetHash + " due to pdfDate parameter");

						// URL 해시가 변경되었을 수 있으므로 현재 섹션에 맞게 플로팅메뉴 상태 갱신
						$(window).trigger('scroll');
					});
				}
			}, 300);
		}



		/* 기준가격 체크 */
		// URL에서 파라미터 추출하는 함수
		function getUrlParameter(name) {
			name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
			var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
			var results = regex.exec(location.search);
			return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
		}

		// URL에서 해시 추출하는 함수
		function getUrlHash() {
			return window.location.hash.substring(1); // '#' 제거
		}

		// 중요 파라미터 확인
		var pdfDate = getUrlParameter('pdfDate');
		var navStartDate = getUrlParameter('navStartDate');
		var navEndDate = getUrlParameter('navEndDate');
		var targetHash = getUrlHash();

		// pdfDate, navStartDate 또는 navEndDate 파라미터가 있고 해시값이 있는 경우
		if ((pdfDate || navStartDate || navEndDate) && targetHash) {
			// 페이지 로딩 후 약간의 지연시간을 둠 (DOM이 완전히 로드되도록)
			setTimeout(function() {
				var headerH = $("#header").outerHeight();
				var targetElement = $("#" + targetHash);

				if (targetElement.length) {
					// 헤더 높이를 고려한 스크롤 위치 계산 (필요시 오프셋 조정)
					var scrollPosition = targetElement.offset().top - headerH - 20;

					// 부드럽게 스크롤
					$('html, body').animate({
						scrollTop: scrollPosition
					}, 0, function() {
						// 스크롤 완료 후 필요한 처리가 있다면 여기에 추가
						console.log("Scrolled to " + targetHash + " due to special URL parameters");

						// URL 해시가 변경되었을 수 있으므로 현재 섹션에 맞게 플로팅메뉴 상태 갱신
						$(window).trigger('scroll');

						// 만약 navStartDate나 navEndDate가 있고 standardPrice로 이동한 경우
						// 여기에 추가 작업을 수행할 수 있습니다 (예: 날짜 필터 설정 등)
						if ((navStartDate || navEndDate) && targetHash === "standardPrice") {
							// 필요한 경우 여기에 추가 로직 구현
							console.log("Nav date parameters detected for standardPrice section");
						}
					});
				}
			}, 300);
		}



		$(".btnClose").click(function() {
			$("#bgBlack").hide();
			$(".layerPop").hide();
		});

		$(".btnPop, .btnAllocation").click(function() {
			$("#bgBlack").show();
			$(".pop3year").show();
		})



		const mobileQuery = window.matchMedia("(max-width: 812px)");
		const tabletQuery = window.matchMedia("(min-width: 813px) and (max-width: 1500px)");
		let prdTrigger, menuTrigger;

		function handleMediaChange() {
			if (mobileQuery.matches) {} else if (tabletQuery.matches) {} else {
				prdTrigger = ScrollTrigger.create({
					trigger: ".m11_view",
					start: "top 150px",
					end: "bottom bottom",
					pin: ".prd>div",
					id: "prdTrigger"
				});
				menuTrigger = ScrollTrigger.create({
					trigger: ".m11_view",
					start: "top 150px",
					end: "bottom bottom",
					pin: ".flotingMenu",
					id: "menuTrigger"
				});
			}
		}
		handleMediaChange();






		// 두 개의 리스트에 대해 더보기 기능 초기화
		initMoreView('.moreList1');
		initMoreView('.moreList2');
		initMoreView('.moreList3');

		// 더보기 기능 초기화 함수
		function initMoreView(tableClass) {
			var $table = $(tableClass);
			var $rows = $table.find('tbody tr');
			var $viewMore = $table.closest('.table').next('.viewMore');
			var $viewMoreBtn = $viewMore; // 버튼 자체가 a 태그입니다
			var $viewCount = $viewMore.find('.view');
			var $totalCount = $viewMore.find('.total');
			var pageSize = 10; // 한 번에 보여줄 행의 수
			var totalRows = $rows.length;
			var currentlyShown = pageSize;
			var $btnTextSpan = $viewMore.find('span').first();
			var $viewIcon = $viewMore.find('i');
			var defaultBtnText = "더보기"; // 기본 버튼 텍스트 저장

			// 초기 상태 설정
			$totalCount.text(totalRows);
			$viewCount.text(Math.min(pageSize, totalRows));

			// 초기 행 숨기기
			$rows.each(function(index) {
				if (index >= pageSize) {
					$(this).hide();
				}
			});

			// 더보기 버튼이 필요없는 경우 숨기기
			if (totalRows <= pageSize) {
				$viewMore.hide();
			}

			// 접기 상태 관리 변수
			var isExpanded = false;

			// 더보기/접기 버튼 클릭 이벤트
			$viewMore.on('click', function() {



				// 접기 상태일 때
				if (isExpanded) {
					// 테이블의 위치 저장
					var tablePosition = $table.offset().top - 20; // 약간 위쪽으로 여유 공간

					// 모든 행 숨기기 (첫 페이지만 제외)
					$rows.each(function(index) {
						if (index >= pageSize) {
							$(this).hide();
						}
					});

					// 상태 초기화
					currentlyShown = pageSize;
					$viewCount.text(currentlyShown);
					// 텍스트 변경 (첫 번째 span 요소의 텍스트 내용 변경)
					$btnTextSpan.text('더보기(' + currentlyShown + '/' + totalRows + ')');
					$viewMore.removeClass('expanded');
					isExpanded = false;

					// 해당 테이블 위치로 스크롤 이동
					$('html, body').animate({
						scrollTop: tablePosition
					}, 0);

					// ScrollTrigger 업데이트
					setTimeout(function() {
						ScrollTrigger.refresh();
					}, 100);

				}
				// 더보기 상태일 때
				else {
					// 다음 페이지의 행들 보이기
					$rows.slice(currentlyShown, currentlyShown + pageSize).show();

					// 현재 보이는 행 수 업데이트
					currentlyShown = Math.min(currentlyShown + pageSize, totalRows);
					$viewCount.text(currentlyShown);

					// 모든 행이 보여진 경우 접기 버튼으로 변경
					if (currentlyShown >= totalRows) {
						// 텍스트 변경 (첫 번째 span 요소의 텍스트 내용 변경)
						$btnTextSpan.text('접기(' + currentlyShown + '/' + totalRows + ')');
						$viewMore.addClass('expanded');
						isExpanded = true;
					}

					// ScrollTrigger 업데이트
					setTimeout(function() {
						ScrollTrigger.refresh();
					}, 100);

				}
			});

		}


		/* floting */
		headerH = $("#header").outerHeight();
		var scrollTimer;


		$(window).scroll(function() {

			clearTimeout(scrollTimer);

			scrollTimer = setTimeout(function() {
				var headerH = $("#header").outerHeight();
				var scroll = $(window).scrollTop() + headerH + 30;

				// 현재 DOM에 존재하는 메뉴 항목 수집
				var menuItems = $(".flotingMenu ul li a");
				var sectionPositions = [];

				// 각 메뉴 항목의 해당 섹션 위치 확인
				menuItems.each(function(index) {
					var target = $(this).attr("href");
					var $section = $(target);

					// 섹션이 존재하는 경우에만 배열에 추가
					if ($section.length) {
						sectionPositions.push({
							target: target,
							position: $section.offset().top,
							menuIndex: index
						});
					}
				});

				// 위치순으로 정렬
				sectionPositions.sort(function(a, b) {
					return a.position - b.position;
				});

				// 현재 활성화할 메뉴 찾기
				var activeMenuIndex = 0;

				// 스크롤 위치에 따라 활성 메뉴 결정
				for (var i = 0; i < sectionPositions.length; i++) {
					if (scroll >= sectionPositions[i].position) {
						activeMenuIndex = sectionPositions[i].menuIndex;
					} else {
						break;
					}
				}

				// 가장 아래 섹션을 지나간 경우 마지막 메뉴 활성화
				if (sectionPositions.length > 0 &&
					scroll >= sectionPositions[sectionPositions.length - 1].position) {
					activeMenuIndex = sectionPositions[sectionPositions.length - 1].menuIndex;
				}

				// 메뉴 활성화 상태 업데이트
				$(".flotingMenu ul li:eq(" + activeMenuIndex + ")").addClass("on").siblings().removeClass("on");
			}, 40); // 스크롤이 끝난 후 200ms 후에 실행


		});


		$(".flotingMenu ul li").click(function() {
			_top = $($(this).find("a").attr('href')).offset().top - headerH;
			$('html, body').stop().animate({
				scrollTop: _top
			}, 200);
		})





		$('.checked_rrTabs').on('click', function() {
			$('.select_rrTabs').slideDown();
			return false; // 이벤트 버블링 방지
		});


		$('.select_rrTabs > li > a').on('click', function() {

			var index = $(this).parent().index();

			$('.checked_rrTabs').text($(this).text());
			$('.rrTabs > li > input').prop('checked', false);
			$('.rrTabs > li').eq(index).find('input').prop('checked', true);

			$('.select_rrTabs').slideUp();
			//return false;

		})






	})
</script>
