				<script>
$(document).ready(function () {
	let isLoading = false; // 로딩 상태 변수
	$(".top10tab").on("click", function () {
		if (isLoading) {
			return false; // 로딩 중이면 클릭 차단
		}

		isLoading = true; // 로딩 시작
		$(".top10tab").prop("disabled", true); // 모든 탭 버튼 비활성화
		showLoading(); // 로딩 표시

		let dataType = $(this).data("pastperiod");
		let idx = 2;


		$.ajax({
			url: "./past_pdf_json.php",
			type: "POST",
			data: { period: dataType, idx: idx },
			dataType: "json",
			success: function (response) {
				if (response.error) {
					console.error("서버 에러:", response.error);
					return;
				}
				updateTop10Lists(response.today, response.past);
			},
			error: function (xhr, status, error) {
				console.error("AJAX 오류:", xhr.responseText);
			},
			complete: function () {
				isLoading = false; // 로딩 완료
				$(".top10tab").prop("disabled", false); // 모든 탭 버튼 활성화
				hideLoading(); // 로딩 숨김
			}
		});

	});

	function updateTop10Lists(todayData, pastData) {
		let todayHtml = "";
		let pastHtml = "";
		const safeToday = Array.isArray(todayData) ? todayData : [];
		const safePast = Array.isArray(pastData) ? pastData : [];

		//오늘의 TOP 10 업데이트
		safeToday.forEach((item, index) => {
			let changeHtml = "";
			const increaseWei = item && item.increaseWei != null ? item.increaseWei : "-";
			const weiValue = item && !isNaN(parseFloat(item.wei)) ? parseFloat(item.wei).toFixed(2) : "0.00";
			const prodNm = (item && item.prodNm) ? item.prodNm : "";

			if (increaseWei === "신규") {
				changeHtml = `<span class="new">신규</span>`;
			} else if (parseFloat(increaseWei) > 0) {
				changeHtml = `<span class="up">+${increaseWei}%</span>`;
			} else if (parseFloat(increaseWei) < 0) {
				changeHtml = `<span class="down">${increaseWei}%</span>`;
			} else {
				changeHtml = "-";
			}

			todayHtml += `
				<li>
					<div class="name"><span>${index + 1}</span>${prodNm}</div>
					<div>${weiValue}%</div>
					<div>${changeHtml}</div>
				</li>
			`;
		});

		//과거의 TOP 10 업데이트 (10개 제한)
		safePast.slice(0, 10).forEach((item, index) => {
			const weiValue = item && !isNaN(parseFloat(item.wei)) ? parseFloat(item.wei).toFixed(2) : "0.00";
			const prodNm = (item && item.prodNm) ? item.prodNm : "";
			pastHtml += `
				<li>
					<div class="name"><span>${index + 1}</span>${prodNm}</div>
					<div>${weiValue}%</div>
				</li>
			`;
		});

		// DOM 업데이트
		$("#todayTop10").html(todayHtml);
		$("#pastTop10").html(pastHtml);
	}

	function showLoading() {
		$("#loadingIndicator").show(); // 로딩 UI 표시
	}

	function hideLoading() {
		$("#loadingIndicator").hide(); // 로딩 UI 숨김
	}

});

</script>
